# ==============================================================================
# Noka JUDGE - Environment Configuration Example
# Copy this file to .env and replace all placeholder values before starting.
# ==============================================================================

# --- Branding (Centralized System Name) ---
APP_NAME=Noka JUDGE
VITE_APP_NAME=Noka JUDGE
APP_ENV=development

# --- Security (MUST CHANGE IN PRODUCTION) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# --- Database (PostgreSQL) ---
POSTGRES_DB=noka_judge
POSTGRES_USER=noka_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://noka_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/noka_judge

# --- Redis Queue ---
REDIS_URL=redis://redis:6379/0

# --- Storage ---
# Use "local" for VPS/Docker volume, or "s3" for Cloudflare R2 / AWS S3 / MinIO (Stateless)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage
# S3-compatible storage (Cloudflare R2 Free 10 GB: https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# --- Judge Engine & Sandbox ---
JUDGE_MODE=docker
JUDGE_DISPATCH_MODE=auto
# Limits simultaneous compile+run jobs when JUDGE_DISPATCH_MODE=thread (set 1 for 512 MB RAM Railway Free)
JUDGE_MAX_CONCURRENT_THREADS=1
JUDGE_SANDBOX_IMAGE=noka-judge-sandbox:latest
JUDGE_WORKER_CONCURRENCY=2
JUDGE_MAX_OUTPUT_BYTES=16777216
JUDGE_COMPILE_TIMEOUT_SEC=15
JUDGE_WORK_DIR=/tmp/noka_judge_runs

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=120
SUBMIT_RATE_LIMIT_PER_MINUTE=15

# --- Frontend ---
VITE_API_BASE_URL=/api/v1

# --- AI Auto-Import (Zero Disk / Zero Storage Footprint) ---
# Free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional fallback provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Production Domain (used by Nginx / Certbot) ---
DOMAIN_NAME=judge.example.com
CERTBOT_EMAIL=admin@example.com
