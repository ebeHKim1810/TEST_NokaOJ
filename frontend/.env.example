# ==============================================================================
# Noka JUDGE Frontend - Environment Variables (Vite / Vercel)
# ==============================================================================

# Display name shown in the UI before backend public-config loads
VITE_APP_NAME=Noka JUDGE

# Backend API base URL:
# - Local dev (via Vite proxy) / VPS with Nginx reverse proxy: /api/v1
# - Vercel production (separate Backend host): https://<your-backend-domain>/api/v1
VITE_API_BASE_URL=/api/v1
